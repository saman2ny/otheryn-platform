# DentalPilot AI — Production environment variables (example)
#
# Copy to .env.production and fill in real values. NEVER commit .env.production.
# `deploy.sh production` sources this file and passes the values to Docker Compose.
#
# Generate secrets with:
#   openssl rand -base64 48   # JWT_SECRET
#   openssl rand -hex 16      # POSTGRES_PASSWORD

# ── Database (PostgreSQL 16 container) ──
POSTGRES_USER=dentalpilot
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
POSTGRES_DB=dentalpilot
# The backend builds DATABASE_URL from the values above; do not set DATABASE_URL
# manually unless you are using an external managed database.

# ── Application ──
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_64_CHARS_MIN
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
APP_ENVIRONMENT=production
# JSON array of allowed frontend origins.
CORS_ORIGINS=["https://dentalpilot.in","https://www.dentalpilot.in"]

# ── AI (Anthropic) — optional; leave empty to disable AI content generation ──
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
ANTHROPIC_MODEL=claude-opus-4-8
CLINICAL_NOTE_DRAFTING_ENABLED=false
CLINICAL_AI_DATA_PROCESSING_APPROVED=false

# ── Payments (Razorpay) — optional; leave empty to disable checkout ──
RAZORPAY_KEY_ID=rzp_live_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME
RAZORPAY_CURRENCY=INR
RAZORPAY_PLAN_IDS={"starter_monthly":"plan_CHANGE_ME","starter_annual":"plan_CHANGE_ME","professional_monthly":"plan_CHANGE_ME","professional_annual":"plan_CHANGE_ME","enterprise_monthly":"plan_CHANGE_ME","enterprise_annual":"plan_CHANGE_ME"}
PATIENT_PAYMENT_CURRENCY=INR

# ── Storage (S3-compatible: AWS S3, Cloudflare R2, MinIO) — optional ──
S3_BUCKET=dentalpilot-prod
S3_ENDPOINT_URL=https://s3.amazonaws.com
AWS_REGION=us-east-1
S3_KMS_KEY_ID=
MAX_PATIENT_DOCUMENT_BYTES=25000000

# ── Email (SMTP) — optional; leave empty to disable email delivery ──
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_SENDER_EMAIL=noreply@dentalpilot.in
SMTP_SENDER_NAME=DentalPilot AI
SMTP_USE_SSL=false
SMTP_USE_STARTTLS=true
EMAIL_WORKER_INTERVAL_SECONDS=10
EMAIL_MAX_ATTEMPTS=5

# ── WhatsApp Cloud API — optional ──
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# ── Billing / subscription worker ──
SUBSCRIPTION_GRACE_PERIOD_DAYS=7
BILLING_WEBHOOK_INTERVAL_SECONDS=5
BILLING_WEBHOOK_MAX_ATTEMPTS=10
SUBSCRIPTION_RECONCILIATION_INTERVAL_SECONDS=3600

# ── Container registry / image tag ──
REGISTRY=ghcr.io
IMAGE_NAME=your-org/dentalpilot-ai
# Pin to an immutable tag (sha-<commit> or a release tag) for reproducible
# deploys. Defaults to `latest` when unset.
IMAGE_TAG=latest