# DentalPilot AI — Staging environment (example)
# Copy to .env.staging and fill in staging values. Never commit real secrets.
# Staging uses the same images as production but non-production credentials and
# a dedicated CORS origin. It is deployed with:
#   docker compose -f docker-compose.yml -f docker-compose.staging.yml up -d

# ── Database ──
POSTGRES_USER=dentalpilot
POSTGRES_PASSWORD=CHANGE_ME_STAGING_POSTGRES_PASSWORD
POSTGRES_DB=dentalpilot

# ── Application ──
APP_ENVIRONMENT=staging
JWT_SECRET=CHANGE_ME_STAGING_JWT_SECRET_64_CHARS_MIN
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=["https://staging.dentalpilot.in","http://localhost:8080"]

# ── AI (Groq) ──
GROQ_API_KEY=gsk_CHANGE_ME
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
CLINICAL_NOTE_DRAFTING_ENABLED=false
CLINICAL_AI_DATA_PROCESSING_APPROVED=false

# ── Payments (Razorpay test mode recommended for staging) ──
RAZORPAY_KEY_ID=rzp_test_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME
RAZORPAY_CURRENCY=INR
RAZORPAY_PLAN_IDS={"starter_monthly":"plan_CHANGE_ME","starter_annual":"plan_CHANGE_ME","professional_monthly":"plan_CHANGE_ME","professional_annual":"plan_CHANGE_ME","enterprise_monthly":"plan_CHANGE_ME","enterprise_annual":"plan_CHANGE_ME"}
PATIENT_PAYMENT_CURRENCY=INR

# ── Storage (S3-compatible) ──
S3_BUCKET=dentalpilot-staging
S3_ENDPOINT_URL=https://s3.amazonaws.com
AWS_REGION=us-east-1
S3_KMS_KEY_ID=
MAX_PATIENT_DOCUMENT_BYTES=25000000

# ── Email (SMTP) ──
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_SENDER_EMAIL=noreply@staging.dentalpilot.in
SMTP_SENDER_NAME=DentalPilot AI
SMTP_USE_SSL=false
SMTP_USE_STARTTLS=true
EMAIL_WORKER_INTERVAL_SECONDS=10
EMAIL_MAX_ATTEMPTS=5

# ── WhatsApp Cloud API ──
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# ── Billing / subscription worker ──
SUBSCRIPTION_GRACE_PERIOD_DAYS=7
BILLING_WEBHOOK_INTERVAL_SECONDS=5
BILLING_WEBHOOK_MAX_ATTEMPTS=10
SUBSCRIPTION_RECONCILIATION_INTERVAL_SECONDS=3600

# ── Container registry ──
REGISTRY=ghcr.io
IMAGE_NAME=your-org/dentalpilot-ai