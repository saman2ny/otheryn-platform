# DentalPilot AI — Local development environment (example)
# Copy to .env.local and fill in local values. .env.local is gitignored.
# These are local-only defaults; never reuse them in staging or production.

# ── Database (PostgreSQL 16 via docker-compose.local.yml) ──
POSTGRES_USER=dentalpilot
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_PASSWORD
POSTGRES_DB=dentalpilot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# The backend builds DATABASE_URL safely from POSTGRES_* via SQLAlchemy
# URL.create(). Keep DATABASE_URL unset for Docker/local Postgres. Only set it
# manually when using an external managed database that cannot be described by
# the POSTGRES_* fields.

# ── Application ──
APP_ENVIRONMENT=development
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_LOCAL_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=["http://localhost:4200"]
BACKEND_PORT=8000

# ── AI (Groq; optional locally; leave empty to disable AI content generation) ──
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
CLINICAL_NOTE_DRAFTING_ENABLED=false
CLINICAL_AI_DATA_PROCESSING_APPROVED=false

# ── Payments (optional locally; leave empty to disable Razorpay) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
RAZORPAY_PLAN_IDS={}
PATIENT_PAYMENT_CURRENCY=INR

# ── Storage (optional locally; leave empty to disable S3 uploads) ──
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_REGION=us-east-1
S3_KMS_KEY_ID=
MAX_PATIENT_DOCUMENT_BYTES=25000000

# ── Email (optional locally; leave empty to disable SMTP delivery) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=DentalPilot AI
SMTP_USE_SSL=false
SMTP_USE_STARTTLS=true
EMAIL_WORKER_INTERVAL_SECONDS=10
EMAIL_MAX_ATTEMPTS=5

# ── WhatsApp Cloud API (optional) ──
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ── Billing worker ──
SUBSCRIPTION_GRACE_PERIOD_DAYS=7
BILLING_WEBHOOK_INTERVAL_SECONDS=5
BILLING_WEBHOOK_MAX_ATTEMPTS=10
SUBSCRIPTION_RECONCILIATION_INTERVAL_SECONDS=3600